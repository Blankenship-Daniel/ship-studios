{
  "enabledMcpjsonServers": [
    "stemmy-loops",
    "stemmy-gemini"
  ],
  "skillListingBudgetFraction": 0.05,
  "permissions": {
    "allow": [
      "mcp__stemmy-loops__*",
      "mcp__stemmy-gemini__*",
      "Bash(uv:*)",
      "Bash(stemmy:*)",
      "Bash(ship-studios:*)",
      "Bash(drum-prep:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ship-studios doctor || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
