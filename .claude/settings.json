{
  "enabledMcpjsonServers": [
    "stemmy-loops",
    "stemmy-gemini"
  ],
  "skillListingBudgetFraction": 0.05,
  "permissions": {
    "allow": [
      "mcp__stemmy-loops__*",
      "mcp__stemmy-gemini__*",
      "Bash(uv:*)",
      "Bash(stemmy:*)",
      "Bash(ship-studios:*)",
