# ship-studios environment — copy to .env and fill in. Never commit real keys.

# Required by the stemmy-loops LLM tools
# (diagnose/ask/suggest/caption-loops/analyze-loops with llm flags)
# and passed through to the loops server.
ANTHROPIC_API_KEY=

# Required by every Gemini-perceptual tool on both servers
# (describe-loops on loops; transcribe/describe/compare/classify/mix-master
# critiques on gemini).
GEMINI_API_KEY=

# --- Optional overrides (leave unset for sensible defaults) ---

# Hub knobs (read by the ship-studios CLI itself):
# SHIP_STUDIOS_LOOPS_DIR=../stemmy-loops-mcp      # sibling location, for a non-default layout
# SHIP_STUDIOS_GEMINI_DIR=../stemmy-gemini-mcp
# SHIP_STUDIOS_STARTUP_TIMEOUT=120                # MCP handshake budget, seconds (0 = no limit)
# SHIP_STUDIOS_CALL_TIMEOUT=600                   # per tool-call budget, seconds (0 = no limit)
# SHIP_STUDIOS_ARTIFACTS_DIR=                     # override <repo>/artifacts
# SHIP_STUDIOS_PROJECTS_DIR=                      # override <repo>/projects

# Server overrides the hub FORWARDS to the spawned servers (keep in sync with
# config.GEMINI_OVERRIDE_ENV / LOOPS_OVERRIDE_ENV and CLAUDE.md's env table):
#   stemmy-loops — LLM model choices
# STEMMY_LLM_MODEL=claude-sonnet-4-6
# STEMMY_LLM_CAPTION_MODEL=claude-haiku-4-5-20251001
#   stemmy-gemini — model + per-call thinking tier + FS allow-list
# STEMMY_MCP_MODEL=gemini-3.1-pro-preview
# STEMMY_MCP_THINKING_LEVEL=high
# STEMMY_MCP_THINKING_BUDGET=8192
# STEMMY_MCP_ALLOWED_ROOTS=/Users/ship/Documents/code/ship-studios

# Server-only — the hub does NOT forward these (the stdio spawn drops them); set
# them in the sibling server's own environment when running it directly:
# STEMMY_CACHE_DIR=~/.cache/stemmy/inference
# STEMMY_NO_CACHE=1
# STEMMY_MCP_GEMINI_TIMEOUT_S=120
# STEMMY_MCP_LOG_LEVEL=WARNING
