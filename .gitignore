# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
# pytest-benchmark autosave baselines are machine/CPU-specific (wall-clock) — don't commit
.benchmarks/

# Secrets / local env
.env
.env.*
!.env.example

# Tool outputs — keep the dir, drop the contents
artifacts/*
!artifacts/.gitkeep

# Project working files — keep the dir + per-track scaffold, drop audio
# (canonical per-track layout: stems/ mix/ masters/ refs/ loops/ deliverables/)
projects/**/stems/*
projects/**/mix/*
projects/**/masters/*
projects/**/refs/*
projects/**/loops/*
projects/**/deliverables/*
projects/**/pack/*
!projects/.gitkeep
!projects/**/.gitkeep

# Audio working files (anywhere)
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.m4a

# macOS
.DS_Store

# Claude Code runtime
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json
