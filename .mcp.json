{
  "mcpServers": {
    "stemmy-loops": {
      "command": "uv",
      "args": [
        "--directory",
        "../stemmy-loops-mcp",
        "run",
        "stemmy-loops-mcp"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "stemmy-gemini": {
      "command": "uv",
      "args": [
        "--directory",
        "../stemmy-gemini-mcp",
        "run",
        "stemmy-gemini-mcp"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}
