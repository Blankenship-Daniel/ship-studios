{
  "mcpServers": {
    "stemmy-loops": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "scripts/mcp_launch.py",
        "stemmy-loops"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "stemmy-gemini": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "scripts/mcp_launch.py",
        "stemmy-gemini"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    }
  }
}
